    "cap:ios": "npm run build && cap sync ios && cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9"
  }
}
